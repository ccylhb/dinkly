---
// Config-driven base layout. All branding comes from site.config.json.
import site from "../../site.config.json";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;
const analyticsToken = (site as Record<string, string>).webAnalyticsToken || "";

const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
const fullTitle = title.includes(site.siteName) ? title : `${title} · ${site.siteName}`;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const graph = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structured = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.siteName,
    url: site.siteUrl,
    description: site.description,
    inLanguage: "en",
  },
  ...graph,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content={site.theme.bg} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Self-hosted latin-subset fonts (see src/styles/fonts.css). Preload the two
        faces that paint above the fold: display roman + body. */}
    <link rel="preload" href="/fonts/fraunces-48642176d9.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-f11d729bb0.woff2" as="font" type="font/woff2" crossorigin />

    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClientId}`}
      crossorigin="anonymous"></script>

    {/* Cloudflare Web Analytics — cookieless, no consent banner needed.
        Token comes from dash.cloudflare.com → Web Analytics → add site.
        Empty token = snippet omitted entirely. */}
    {analyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label={`${site.siteName} home`}>
          {site.siteName}<span class="brand-dot">.</span>
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
        <nav class="main-nav" id="mainNav" aria-label="Main">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={path === item.href.replace(/\/+$/, "") || (item.href !== "/" && path === item.href.replace(/\/+$/, "")) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-cta">
          <a class="btn btn-primary btn-sm" href="/daily-draw/">Take a break ✦</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">{site.siteName}<span class="brand-dot">.</span></div>
            <p class="footer-desc">{site.footerNote}</p>
            <div class="footer-stats">
              <div class="footer-stat"><b class="num">4.2 min</b><span>avg. break</span></div>
              <div class="footer-stat"><b class="num">24</b><span>tiny escapes</span></div>
              <div class="footer-stat"><b class="num">$0</b><span>forever free</span></div>
            </div>
          </div>
          <div class="footer-col">
            <h4>Play</h4>
            <a href="/daily-draw/">Daily Draw</a>
            <a href="/quizzes/">Quizzes</a>
            <a href="/games/">Tiny Games</a>
            <a href="/jokes/">Joke Jar</a>
          </div>
          <div class="footer-col">
            <h4>Vibe</h4>
            <a href="/sounds/">Focus Sounds</a>
            <a href="/oracle/">Yes / No Oracle</a>
            <a href="/wallpapers/">Wallpapers</a>
            <a href="/blog/">Break Notes</a>
          </div>
          <div class="footer-col">
            <h4>Company</h4>
            <a href="/about/">About</a>
            <a href="/advertise/">Advertise</a>
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms/">Terms</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {site.siteName}. Made for the waiting times.</span>
          <span>EN now · ES / PT soon</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var t = document.getElementById("navToggle");
        var n = document.getElementById("mainNav");
        if (!t || !n) return;
        t.addEventListener("click", function () {
          var open = n.classList.toggle("open");
          t.setAttribute("aria-expanded", open ? "true" : "false");
        });
      })();
    </script>
  </body>
</html>
