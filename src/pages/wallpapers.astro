---
import Base from "../layouts/Base.astro";

const drops = [
  { id: "w1", name: "Dusk Grape", mood: "Calm", a: "#7A5CFF", b: "#FF9EC4", c: "#241E3C" },
  { id: "w2", name: "Bubblegum Fog", mood: "Cheerful", a: "#FF9EC4", b: "#FFD37E", c: "#FFF3F8" },
  { id: "w3", name: "Mint Static", mood: "Focused", a: "#7FE0C3", b: "#8FD0FF", c: "#EAFBF6" },
  { id: "w4", name: "Deep Water", mood: "Sleepy", a: "#241E3C", b: "#4C6FB8", c: "#0E1223" },
  { id: "w5", name: "Golden Hour", mood: "Warm", a: "#FFD37E", b: "#FF9EC4", c: "#3A2A1F" },
  { id: "w6", name: "Paper Light", mood: "Minimal", a: "#FAFAF7", b: "#ECE9F1", c: "#F3F1FA" },
  { id: "w7", name: "Blue Hour", mood: "Melancholy", a: "#3E5C8A", b: "#8FD0FF", c: "#141B2C" },
  { id: "w8", name: "Peach Sorbet", mood: "Cozy", a: "#FFB59B", b: "#FFD37E", c: "#FFEEE8" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Wallpaper Drop",
  description: "Free gradient wallpapers generated as pure CSS and exportable as PNG, sized for desktop and phone.",
};
---

<Base
  title="Wallpaper Drop — free generated gradient wallpapers"
  description="Eight free gradient wallpapers you can download as PNG in desktop and phone sizes. No signup, no watermark, no email required."
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Wallpaper Drop</span>
    </nav>

    <header class="head">
      <span class="kicker">✦ {drops.length} gradients · free download</span>
      <h1>Wallpaper Drop.</h1>
      <p class="lede">
        Eight soft gradients, drawn as pure CSS and exported to PNG right here in your browser.
        Pick a mood, choose a size, save it. No account, no email, no watermark.
      </p>
    </header>

    <div class="wp-grid">
      {drops.map((d) => (
        <article class="wp-card" style={`--a:${d.a};--b:${d.b};--c:${d.c}`}>
          <div class="wp-preview" data-a={d.a} data-b={d.b} data-c={d.c}></div>
          <div class="wp-info">
            <h2>{d.name}</h2>
            <p>{d.mood}</p>
          </div>
          <div class="wp-actions">
            <button class="btn btn-ghost btn-sm" type="button" data-dl={d.id} data-name={d.name}>Desktop 2560×1440</button>
            <button class="btn btn-primary btn-sm" type="button" data-dl={d.id} data-name={d.name} data-mobile="1">Phone 1170×2532</button>
          </div>
          <span class="wp-note" data-note={d.id} role="status"></span>
        </article>
      ))}
    </div>

    <div class="ad-slot ad-inline">Ad slot · 728×90</div>

    <section class="how">
      <h2>How these are made</h2>
      <p class="muted">
        Every wallpaper is a two-stop linear gradient with a tinted overlay, defined in CSS and redrawn on a
        canvas at export time. That means the files are genuinely generated on your device — nothing is
        downloaded from a server, and the site stays fast enough to load inside one model response.
      </p>
    </section>

    <section class="more">
      <h2>Other cozy things</h2>
      <div class="more-grid">
        <a class="more-card" href="/sounds/"><span aria-hidden="true">🎧</span><h3>Focus Sounds</h3><p>Four ambient rooms, also generated in-browser.</p></a>
        <a class="more-card" href="/daily-draw/"><span aria-hidden="true">🎴</span><h3>Daily Draw</h3><p>A new card every morning, same for everybody.</p></a>
        <a class="more-card" href="/blog/three-minute-break/"><span aria-hidden="true">📓</span><h3>The 3-minute break</h3><p>Twelve micro-breaks that actually fit.</p></a>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ drops }}>
    (function () {
      document.querySelectorAll(".wp-preview").forEach(function (el) {
        var a = el.getAttribute("data-a"), b = el.getAttribute("data-b"), c = el.getAttribute("data-c");
        el.style.background =
          "radial-gradient(120% 90% at 18% 12%, " + a + " 0%, transparent 58%)," +
          "radial-gradient(110% 80% at 84% 78%, " + b + " 0%, transparent 60%)," +
          "linear-gradient(150deg, " + c + ", " + c + ")";
      });

      document.querySelectorAll("[data-dl]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-dl");
          var d = drops.filter(function (x) { return x.id === id; })[0];
          if (!d) return;
          var mobile = btn.getAttribute("data-mobile") === "1";
          var W = mobile ? 1170 : 2560, H = mobile ? 2532 : 1440;
          var cv = document.createElement("canvas");
          cv.width = W; cv.height = H;
          var g = cv.getContext("2d");

          g.fillStyle = d.c; g.fillRect(0, 0, W, H);

          function radial(cx, cy, r, color) {
            var rg = g.createRadialGradient(cx * W, cy * H, 0, cx * W, cy * H, r * Math.max(W, H));
            rg.addColorStop(0, color);
            rg.addColorStop(1, "rgba(0,0,0,0)");
            g.fillStyle = rg; g.fillRect(0, 0, W, H);
          }
          radial(0.18, 0.12, 1.1, d.a + "cc");
          radial(0.84, 0.78, 1.0, d.b + "cc");
          radial(0.5, 0.5, 0.9, d.a + "33");

          try {
            var url = cv.toDataURL("image/png");
            var a = document.createElement("a");
            a.href = url;
            a.download = "dinkly-" + d.name.toLowerCase().replace(/\s+/g, "-") + (mobile ? "-phone" : "-desktop") + ".png";
            a.click();
            var note = document.querySelector('[data-note="' + id + '"]');
            if (note) note.textContent = "Saved to your downloads.";
          } catch (e) {
            var note2 = document.querySelector('[data-note="' + id + '"]');
            if (note2) note2.textContent = "Your browser blocked the download.";
          }
        });
      });
    })();
  </script>
</Base>

<style>
  .page { padding: 34px 0 20px; }
  .crumbs { font-size: 13.5px; color: var(--faint); display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }
  .head { max-width: 700px; margin: 26px 0 36px; }
  .head h1 { font-size: clamp(32px, 4.4vw, 50px); margin: 16px 0 14px; }
  .lede { color: var(--muted); font-size: 16.5px; }

  .wp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .wp-card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 14px; display: flex; flex-direction: column; gap: 12px;
  }
  .wp-preview {
    aspect-ratio: 16 / 10; border-radius: var(--r-md); border: 1px solid var(--border);
    overflow: hidden;
  }
  .wp-info { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .wp-info h2 { font-size: 16px; }
  .wp-info p { font-size: 12.5px; color: var(--faint); margin: 0; }
  .wp-actions { display: flex; flex-direction: column; gap: 8px; }
  .wp-actions .btn { width: 100%; font-size: 12.5px; padding: 9px 12px; }
  .wp-note { font-size: 12px; color: var(--accent); min-height: 15px; }

  .ad-inline { margin: 42px 0 0; }
  .how { margin-top: 52px; max-width: 760px; }
  .how h2 { font-size: 26px; margin-bottom: 12px; }
  .more { margin-top: 56px; }
  .more h2 { font-size: 26px; margin-bottom: 20px; }
  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .more-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .more-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .more-card span { font-size: 26px; }
  .more-card h3 { font-size: 18px; margin: 12px 0 6px; }
  .more-card p { font-size: 14px; color: var(--muted); margin: 0; }

  @media (max-width: 1100px) { .wp-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px) { .wp-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) {
    .more-grid { grid-template-columns: 1fr; }
  }
</style>
