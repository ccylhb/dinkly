---
import Base from "../layouts/Base.astro";
import jokes from "../data/jokes.json";

const featured = jokes[0];
const rest = jokes.slice(1);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Joke Jar",
  description: `${jokes.length} short, clean jokes for the two minutes your AI is thinking.`,
};
---

<Base
  title="Joke Jar — short jokes for the two-minute wait"
  description={`${jokes.length} short, clean jokes you can read in the time it takes a model to answer. Tech, AI, and general-purpose silliness. No signup.`}
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Joke Jar</span>
    </nav>

    <header class="head">
      <span class="kicker">✦ {jokes.length} jokes · 10 seconds each</span>
      <h1>The Joke Jar.</h1>
      <p class="lede">
        Reach in, pull one out, keep reading while the spinner spins.
        Setups are visible, punchlines are one click away — so you can't ruin it by accident.
      </p>
    </header>

    <div class="jar-layout">
      <article class="jar" id="jar">
        <span class="jar-label">Today's draw</span>
        <p class="jar-setup" id="jarSetup">{featured.setup}</p>
        <p class="jar-punch" id="jarPunch" hidden></p>
        <div class="jar-actions">
          <button class="btn btn-primary btn-sm" type="button" id="jarReveal">Reveal punchline</button>
          <button class="btn btn-ghost btn-sm" type="button" id="jarNext">Another one</button>
        </div>
      </article>

      <aside class="jar-side">
        <h2 class="side-title">Keep it on your desk</h2>
        <p class="muted">
          The Joke Jar is 100% offline-friendly and free forever — no account, no email, no way for us to
          know whether you laughed. That's the entire business model of this section.
        </p>
        <div class="ad-slot ad-side">Ad slot · 300×250</div>
      </aside>
    </div>

    <section class="all">
      <h2>All {jokes.length} jokes</h2>
      <p class="muted">Grouped so you can find one for the occasion. Tap any setup to see the punchline.</p>
      <div class="joke-grid">
        {rest.map((j, i) => (
          <details class="joke-card" data-tag={j.tag}>
            <summary>
              <span class="joke-num num">#{String(i + 2).padStart(2, "0")}</span>
              <span class="joke-setup">{j.setup}</span>
              <span class="joke-tag">{j.tag}</span>
            </summary>
            <p class="joke-punch">{j.punchline}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="more">
      <h2>If the jokes ran out</h2>
      <div class="more-grid">
        <a class="more-card" href="/daily-draw/"><span aria-hidden="true">🎴</span><h3>Daily Draw</h3><p>One card a day, thirty seconds of calm.</p></a>
        <a class="more-card" href="/oracle/"><span aria-hidden="true">🔮</span><h3>Yes / No Oracle</h3><p>Ask one thing, get a straight answer.</p></a>
        <a class="more-card" href="/games/dink-match/"><span aria-hidden="true">🃏</span><h3>Dink Match</h3><p>Emoji memory. Two minutes a round.</p></a>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ pool: jokes }}>
    (function () {
      var setup = document.getElementById("jarSetup");
      var punch = document.getElementById("jarPunch");
      var current = pool[0];
      ["jarSetup", "jarPunch"].forEach(function () {});

      document.getElementById("jarReveal").addEventListener("click", function () {
        punch.textContent = current.punchline;
        punch.hidden = false;
      });

      document.getElementById("jarNext").addEventListener("click", function () {
        var next = current;
        while (next === current) next = pool[Math.floor(Math.random() * pool.length)];
        current = next;
        setup.textContent = current.setup;
        punch.hidden = true;
        punch.textContent = "";
        document.getElementById("jar").animate(
          [{ transform: "rotate(-2deg)" }, { transform: "rotate(1.5deg)" }, { transform: "none" }],
          { duration: 320, easing: "ease-out" }
        );
      });
    })();
  </script>
</Base>

<style>
  .page { padding: 34px 0 20px; }
  .crumbs { font-size: 13.5px; color: var(--faint); display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }
  .head { max-width: 700px; margin: 26px 0 36px; }
  .head h1 { font-size: clamp(32px, 4.4vw, 52px); margin: 16px 0 14px; }
  .lede { color: var(--muted); font-size: 16.5px; }

  .jar-layout { display: grid; grid-template-columns: 1.55fr 1fr; gap: 24px; align-items: start; }
  .jar {
    border-radius: var(--r-xl); padding: 40px 38px; min-height: 280px;
    background: linear-gradient(150deg, #fff6e2, #fff 58%, #fdf2ff);
    border: 1px solid #f4e6c9; box-shadow: var(--shadow-md);
    display: flex; flex-direction: column;
  }
  .jar-label { font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #c9922b; }
  .jar-setup { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); line-height: 1.3; margin: 20px 0 0; }
  .jar-punch {
    font-family: var(--font-display); font-style: italic; font-size: clamp(20px, 2.3vw, 26px);
    line-height: 1.35; margin: 16px 0 0; color: var(--accent); font-weight: 600;
  }
  .jar-actions { display: flex; gap: 12px; margin-top: auto; padding-top: 28px; flex-wrap: wrap; }

  .side-title { font-size: 20px; margin-bottom: 10px; }
  .ad-side { margin-top: 20px; min-height: 240px; }

  .all { margin-top: 60px; }
  .all h2 { font-size: 26px; margin-bottom: 8px; }
  .joke-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 22px; }
  .joke-card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--r-md);
    padding: 0; overflow: hidden;
  }
  .joke-card summary {
    display: flex; align-items: baseline; gap: 12px; padding: 16px 20px; cursor: pointer;
    list-style: none; font-size: 15px;
  }
  .joke-card summary::-webkit-details-marker { display: none; }
  .joke-card:hover { border-color: var(--border-strong); }
  .joke-num { font-size: 12px; color: var(--faint); flex: none; }
  .joke-setup { flex: 1; }
  .joke-tag { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); border: 1px solid var(--border); border-radius: 999px; padding: 3px 9px; flex: none; }
  .joke-punch { margin: 0; padding: 0 20px 18px 52px; font-size: 15px; color: var(--accent); font-weight: 500; }
  .joke-card[open] { border-color: var(--accent); background: var(--accent-soft); }

  .more { margin-top: 60px; }
  .more h2 { font-size: 26px; margin-bottom: 20px; }
  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .more-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .more-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .more-card span { font-size: 26px; }
  .more-card h3 { font-size: 18px; margin: 12px 0 6px; }
  .more-card p { font-size: 14px; color: var(--muted); margin: 0; }

  @media (max-width: 980px) {
    .jar-layout { grid-template-columns: 1fr; }
    .joke-grid { grid-template-columns: 1fr; }
    .more-grid { grid-template-columns: 1fr; }
  }
</style>
