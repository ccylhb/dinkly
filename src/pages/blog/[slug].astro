---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const all = (await getCollection("blog")).filter((p) => p.id !== post.id).sort((a, b) => b.data.order - a.data.order);
const related = all.slice(0, 2);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.date,
    author: { "@type": "Organization", name: "Dinkly" },
    publisher: { "@type": "Organization", name: "Dinkly" },
    mainEntityOfPage: `https://dinkly.lootseer.com/blog/${post.id}/`,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://dinkly.lootseer.com/" },
      { "@type": "ListItem", position: 2, name: "Break Notes", item: "https://dinkly.lootseer.com/blog/" },
      { "@type": "ListItem", position: 3, name: post.data.title },
    ],
  },
];
---

<Base title={`${post.data.title} — Dinkly Break Notes`} description={post.data.description} jsonLd={jsonLd}>
  <div class="wrap narrow page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/blog/">Break Notes</a> <span aria-hidden="true">/</span>
      <span>{post.data.title}</span>
    </nav>

    <article class="post">
      <header class="post-head">
        <span class="post-emoji" aria-hidden="true">{post.data.emoji}</span>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span>{new Date(post.data.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</span>
          <span aria-hidden="true">·</span>
          <span>{post.data.readingTime} read</span>
        </div>
      </header>

      <div class="prose"><Content /></div>

      <div class="ad-slot ad-inline">Ad slot · in-article</div>

      <div class="post-cta">
        <p><strong>Your agent still thinking?</strong> That's one wait, and it's already paid for.</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-sm" href="/daily-draw/">Pull today's card</a>
          <a class="btn btn-ghost btn-sm" href="/quizzes/">Take a quiz</a>
        </div>
      </div>
    </article>

    <section class="next">
      <h2>Keep reading</h2>
      <div class="next-grid">
        {related.map((p) => (
          <a class="next-card" href={`/blog/${p.id}/`}>
            <span aria-hidden="true">{p.data.emoji}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .narrow { max-width: 820px; }
  .page { padding: 34px 0 20px; }
  .crumbs { font-size: 13.5px; color: var(--faint); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }

  .post-head { margin: 30px 0 34px; }
  .post-emoji { font-size: 36px; display: block; margin-bottom: 14px; }
  .post-head h1 { font-size: clamp(30px, 4vw, 46px); }
  .post-meta { display: flex; gap: 10px; font-size: 13.5px; color: var(--faint); margin-top: 16px; }

  .prose { font-size: 17px; line-height: 1.78; }
  .prose :global(h2) { font-size: 27px; margin: 42px 0 14px; }
  .prose :global(h3) { font-size: 20px; margin: 30px 0 10px; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; padding-left: 24px; }
  .prose :global(li) { margin-bottom: 9px; }
  .prose :global(a) { color: var(--accent); font-weight: 500; border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .prose :global(a:hover) { border-bottom-color: var(--accent); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(blockquote) {
    margin: 26px 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--accent2);
    color: var(--muted); font-style: italic;
  }
  .prose :global(hr) { border: 0; height: 1px; background: var(--border); margin: 40px 0; }
  .prose :global(code) {
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: 6px;
    padding: 2px 7px; font-size: 0.9em; font-family: var(--font-num);
  }

  .ad-inline { margin: 44px 0 0; }
  .post-cta {
    margin-top: 40px; padding: 28px; border-radius: var(--r-lg);
    background: linear-gradient(150deg, #f3edff, #fff5fa); border: 1px solid #ece5fb;
  }
  .post-cta p { margin: 0 0 16px; font-size: 16px; }
  .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .next { margin-top: 56px; }
  .next h2 { font-size: 24px; margin-bottom: 18px; }
  .next-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .next-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .next-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .next-card span { font-size: 24px; }
  .next-card h3 { font-size: 18px; margin: 12px 0 8px; }
  .next-card p { font-size: 14px; color: var(--muted); margin: 0; }

  @media (max-width: 700px) {
    .next-grid { grid-template-columns: 1fr; }
    .prose { font-size: 16.5px; }
  }
</style>
