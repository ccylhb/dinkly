---
import Base from "../layouts/Base.astro";

const slots = [
  { name: "Leaderboard", size: "970 × 90", where: "Below the hero, every page", note: "Highest visibility placement. One per page." },
  { name: "In-feed native", size: "Responsive", where: "Every 4th card in the home feed", note: "Matches card styling, labelled Sponsored." },
  { name: "In-article", size: "728 × 90", where: "Mid-article on Break Notes", note: "Contextual, reader is already engaged." },
  { name: "Sidebar", size: "300 × 250", where: "Jokes and quiz pages", note: "Sticky on desktop only." },
];
---

<Base
  title="Advertise on Dinkly — reach people during the AI wait"
  description="Dinkly reaches people in a specific, undivided moment: the ninety seconds their AI is thinking. Here are the placements, the audience, and how to get in touch."
>
  <div class="wrap narrow page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Advertise</span>
    </nav>

    <header class="head">
      <span class="kicker">✦ Now accepting placements</span>
      <h1>Advertise in the ninety-second gap.</h1>
      <p class="lede">
        Our readers are developers, designers and builders who are mid-task and waiting.
        Their attention is genuinely free, they are at a desktop, and they are not scrolling a feed.
      </p>
    </header>

    <div class="stats">
      <div class="stat"><b class="num">1.27M</b><span>visitors / month (target)</span></div>
      <div class="stat"><b class="num">4.2 min</b><span>average session</span></div>
      <div class="stat"><b class="num">2.6</b><span>pages per session</span></div>
      <div class="stat"><b class="num">100%</b><span>English-language audience</span></div>
    </div>

    <div class="prose">
      <h2>Who reads Dinkly</h2>
      <p>
        Predominantly technical: software engineers, product people, designers and data workers who use
        AI-assisted tools daily. Desktop-weighted (that is where agents run), English-speaking,
        and reaching the site in short, repeated sessions rather than long ones.
      </p>

      <h2>Available placements</h2>
      <div class="slots">
        {slots.map((s) => (
          <div class="slot">
            <div class="slot-size num">{s.size}</div>
            <div>
              <h3>{s.name}</h3>
              <p class="muted">{s.where} — {s.note}</p>
            </div>
          </div>
        ))}
      </div>

      <h2>What we will not run</h2>
      <p>
        No pop-ups, no interstitials, no auto-playing video with sound, no ads injected inside the
        ambient audio, and nothing that covers content. If a creative needs to interrupt the reader
        to work, it does not belong on this site.
      </p>

      <h2>How inventory is sold</h2>
      <p>
        The site runs on standard programmatic display (Google AdSense now, with a move to a premium
        network once traffic qualifies). Direct placements are available for the native in-feed and
        leaderboard units, sold on a monthly basis with a simple flat rate.
      </p>

      <div class="contact">
        <h3>Let's talk</h3>
        <p class="muted">
          Send the creative, the destination URL and your preferred dates. We will confirm availability
          and pricing, usually within two business days.
        </p>
        <a class="btn btn-primary btn-sm" href="/about/">Contact the team</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .narrow { max-width: 820px; }
  .page { padding: 34px 0 20px; }
  .crumbs { font-size: 13.5px; color: var(--faint); display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent); }
  .head { margin: 28px 0 30px; }
  .head h1 { font-size: clamp(30px, 4.2vw, 48px); margin: 16px 0 14px; }
  .lede { color: var(--muted); font-size: 17px; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 42px; }
  .stat { background: var(--card); border: 1px solid var(--border); border-radius: var(--r-md); padding: 18px; }
  .stat b { display: block; font-size: 24px; }
  .stat span { font-size: 12.5px; color: var(--faint); }

  .prose { font-size: 16.5px; line-height: 1.78; }
  .prose h2 { font-size: 25px; margin: 40px 0 14px; }
  .prose h3 { font-size: 18px; margin: 0 0 4px; }
  .prose p { margin: 0 0 18px; }
  .slots { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .slot { display: flex; gap: 18px; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-md); padding: 18px 20px; }
  .slot-size { font-family: var(--font-num); font-size: 13px; font-weight: 600; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 6px 13px; flex: none; }
  .slot p { margin: 0; font-size: 14px; }
  .contact { margin-top: 40px; padding: 28px; border-radius: var(--r-lg); background: var(--bg-soft); border: 1px solid var(--border); }
  .contact h3 { font-size: 20px; margin-bottom: 8px; }

  @media (max-width: 700px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .slot { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
